// Jinnah League — database schema (PostgreSQL on Neon, managed with Prisma).
// Conventions
//  - Tables/columns are snake_case in PostgreSQL (via @@map/@map), camelCase in Prisma Client.
//  - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
//  - Timestamps are timestamptz. `updatedAt` is maintained by Prisma Client.
//  - Rows referencing media_assets use ON DELETE RESTRICT so a file that is still
//    in use cannot be removed by accident.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

// Simple role column now; can grow into a roles/permissions table later without touching users.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR

  @@map("user_role")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum MessageStatus {
  UNREAD
  READ
  RESOLVED

  @@map("message_status")
}

enum MediaFileType {
  IMAGE
  LOGO
  BANNER
  DOCUMENT
  OTHER

  @@map("media_file_type")
}

enum PressItemType {
  PRESS_COVERAGE
  MEDIA_KIT

  @@map("press_item_type")
}

// ───────────────────────────── Core ─────────────────────────────

/// Administrator accounts (CMS login). No public registration.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String     @db.VarChar(100)
  /// Stored lowercase (normalised by the API) so the unique index is case-insensitive in practice.
  email           String     @unique @db.VarChar(255)
  /// Argon2id hash. Never returned by the API.
  passwordHash    String     @map("password_hash")
  profileImageUrl String?    @map("profile_image_url")
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(ADMIN)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAssets MediaAsset[]
  sessions    Session[]

  @@map("users")
}

/// Server-side login sessions (PostgreSQL-backed). Lets us revoke sessions instantly,
/// e.g. after a password change or when an account is disabled.
model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 of the random cookie token. The raw token is never stored.
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  /// Per-session CSRF token (synchronizer token), sent back by the CMS in the X-CSRF-Token header.
  csrfToken  String   @map("csrf_token") @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  /// Idle expiry; extended while the admin is active (see SESSION_IDLE_HOURS).
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Public contact form submissions.
model ContactMessage {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(255)
  subject   String?       @db.VarChar(200)
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
}

/// Metadata for files kept in object storage (the files themselves are NOT stored in PostgreSQL).
model MediaAsset {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Generated unique object name / key inside the storage bucket.
  fileName     String        @unique @map("file_name") @db.VarChar(255)
  originalName String        @map("original_name") @db.VarChar(255)
  fileUrl      String        @map("file_url")
  fileType     MediaFileType @default(IMAGE) @map("file_type")
  mimeType     String        @map("mime_type") @db.VarChar(100)
  /// Size in bytes.
  fileSize     Int           @map("file_size")
  altText      String?       @map("alt_text") @db.VarChar(255)
  /// Kept (set to NULL) if the uploading admin is later deleted.
  uploadedById String?       @map("uploaded_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  galleryItems    GalleryItem[]
  heroSlides      HeroSlide[]
  sponsorTiers    SponsorTier[]
  pressItems      PressItem[]
  websiteSettings WebsiteSetting[]

  @@index([fileType, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("media_assets")
}

/// Images shown on the public Gallery page. Reuses Media Library files.
model GalleryItem {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId String        @map("media_asset_id") @db.Uuid
  title        String?       @db.VarChar(150)
  description  String?
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@index([mediaAssetId])
  @@map("gallery_items")
}

// ───────────────────────── Website content ─────────────────────────

/// CMS-managed pages (home, about, legacy, jl26, sponsors, media, gallery, contact, ...).
model Page {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String        @db.VarChar(150)
  slug            String        @unique @db.VarChar(150)
  description     String?
  status          ContentStatus @default(DRAFT)
  metaTitle       String?       @map("meta_title") @db.VarChar(200)
  metaDescription String?       @map("meta_description") @db.VarChar(320)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sections PageSection[]

  @@index([status])
  @@map("pages")
}

/// Ordered building blocks of a page. Structured/flexible parts live in JSONB.
model PageSection {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId        String        @map("page_id") @db.Uuid
  /// e.g. "text", "cards", "stats", "timeline". A string (validated with Zod in the API),
  /// not an enum, so new section types never require a database migration.
  sectionType   String        @map("section_type") @db.VarChar(50)
  title         String?       @db.VarChar(200)
  content       Json          @default("{}") @db.JsonB
  configuration Json          @default("{}") @db.JsonB
  displayOrder  Int           @default(0) @map("display_order")
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Sections belong to their page: deleting a page removes its sections.
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, displayOrder])
  @@map("page_sections")
}

// ───────────────────────── Dedicated CMS modules ─────────────────────────

/// Homepage hero slider.
model HeroSlide {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String        @db.VarChar(200)
  subtitle     String?       @db.VarChar(200)
  description  String?
  mediaAssetId String?       @map("media_asset_id") @db.Uuid
  buttonText   String?       @map("button_text") @db.VarChar(60)
  buttonUrl    String?       @map("button_url")
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@index([mediaAssetId])
  @@map("hero_slides")
}

/// One URL per social platform.
model SocialLink {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "facebook", "instagram", "linkedin" (validated in the API; new platforms need no migration).
  platform     String        @unique @db.VarChar(50)
  url          String
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, displayOrder])
  @@map("social_links")
}

/// Key/value site configuration (site name, tagline, contact details, logo, favicon, ...).
model WebsiteSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  /// Group used to organise the settings screen: "general", "branding", "contact", "seo", ...
  settingGroup String   @default("general") @map("setting_group") @db.VarChar(50)
  /// Any JSON scalar/object (string, number, boolean, ...), so each setting keeps its real type.
  settingValue Json?    @map("setting_value") @db.JsonB
  /// For file-valued settings (logo, favicon) so the file stays referentially protected.
  mediaAssetId String?  @map("media_asset_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([settingGroup])
  @@index([mediaAssetId])
  @@map("website_settings")
}

/// Sponsorship tiers section.
model SponsorTier {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique @db.VarChar(100)
  description  String?
  /// Native PostgreSQL text[] — one entry per benefit.
  benefits     String[]      @default([])
  logoMediaId  String?       @map("logo_media_id") @db.Uuid
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  logoMedia MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@index([logoMediaId])
  @@map("sponsor_tiers")
}

/// Press coverage links and media-kit downloads.
model PressItem {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String        @db.VarChar(250)
  description  String?
  itemType     PressItemType @map("item_type")
  /// Outlet / publication name (press coverage).
  sourceName   String?       @map("source_name") @db.VarChar(150)
  /// Publication date (press coverage).
  publishedOn  DateTime?     @map("published_on") @db.Date
  mediaAssetId String?       @map("media_asset_id") @db.Uuid
  externalUrl  String?       @map("external_url")
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([itemType, status, displayOrder])
  @@index([mediaAssetId])
  @@map("press_items")
}
